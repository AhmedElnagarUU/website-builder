# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# AWS S3
# The bucket needs two statements on arn:aws:s3:::{bucket}/sites/* :
#   s3:GetObject    for Principal "*"          -> images are readable from S3_PUBLIC_BASE_URL
#   s3:DeleteObject for the app's IAM user     -> deleting a site removes its images
# Apply them with:  node scripts/s3/ensure-site-image-access.cjs
S3_BUCKET=            # e.g. my-app-assets
S3_REGION=us-east-1   # MUST match the bucket's actual region (e.g. us-east-1, eu-west-1)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://my-app-assets.s3.us-east-1.amazonaws.com  # public read base URL for uploaded objects (https://{bucket}.s3.{region}.amazonaws.com)

# AI generation (GPT-like provider fallback, e.g. OpenRouter or OpenAI-compatible)
AI_API_BASE_URL=             # e.g. https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=                    # e.g. gpt-4o-mini
OPENROUTER_API_KEY=          # fallback key when AI_API_KEY is unset

# AI generation via Google Gemini (used when GEMINI_KEY is set)
GEMINI_KEY=                  # Google AI Studio API key
AI_GEMINI_BASE_URL=          # optional; default https://generativelanguage.googleapis.com/v1beta
AI_GEMINI_MODEL=             # optional; default gemini-3.6-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITES_DOMAIN=    # e.g. platformsites.com — published sites live at {slug}.{NEXT_PUBLIC_SITES_DOMAIN}

PEXELS_API_KEY=apikeyfrompexels

# Polar (the only payment provider — migration EPIC 24)
# Real env names from official Polar docs. Create in Polar dashboard; values are empty placeholders — you fill later.
# Hosted checkout is server-side: POST /api/checkout creates the session and the
# browser follows the returned URL; the Polar webhook is the source of truth.
# Paymob was fully removed (code, env vars, pixel).
POLAR_ACCESS_TOKEN=                              # Server-only Polar access token (starts polar_oat_...). NEVER send to the browser. Create in Polar → Org settings.
POLAR_ORGANIZATION_ID=                           # Your Polar organization ID (UUID). Shown in Polar dashboard settings.
POLAR_WEBHOOK_SECRET=                            # Polar webhook signing secret (Standard Webhooks, starts whsec_...). From Polar → Settings → Webhooks → Create Endpoint.
POLAR_SERVER=sandbox                             # polar provider environment: sandbox | production. Use sandbox for testing (Standard Webhooks HMAC differs accordingly).
POLAR_PRODUCT_ID_PRO=                            # Polar product ID for the Pro plan (UUID). From Polar → Products.

# ---- Manual payment methods (Egypt: Vodafone Cash / InstaPay) ----
# Offered only to accounts whose stored user.country is "EG" (captured at signup
# from proxy headers) — an unset number does NOT hide the method, the number
# line just renders blank until it is filled in.
# Verification is manual: only emails listed in ADMIN_EMAILS can grant it. No
# admin UI yet, so with ADMIN_EMAILS unset nobody can verify a manual payment.
ADMIN_EMAILS=                                    # Comma-separated admin emails allowed to verify manual payments, e.g. owner@example.com
MANUAL_PAYMENT_VODAFONE_NUMBER=                  # Vodafone Cash wallet number shown to EG users (e.g. 01012345678)
MANUAL_PAYMENT_INSTAPAY_NUMBER=                  # InstaPay business number/IBAN shown to EG users
MANUAL_PAYMENT_EXPIRE_HOURS=24                   # Hours a manual payment request stays valid before it expires
                      